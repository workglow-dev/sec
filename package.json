{
  "name": "@workglow/sec",
  "type": "module",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/sec.git"
  },
  "bugs": {
    "url": "https://github.com/workglow-dev/sec/issues"
  },
  "homepage": "https://workglow.dev",
  "description": "A worked example of the Workglow libraries: SEC EDGAR and Form ADV ingestion, filing-to-markdown conversion, and retrieval-grounded question answering over what filings say.",
  "scripts": {
    "release-checks": "bun ./scripts/releaseChecks.ts",
    "release": "bun run release-checks && bunset --auto --push --commit --tag",
    "prepack-check": "bun ./scripts/checkPackedContents.ts",
    "smoke-bins": "bun ./scripts/smokeBinaries.ts",
    "dev": "concurrently -c 'auto' -n 'sec:' 'bun:dev-*'",
    "dev-sec": "bun build --watch --target=bun --sourcemap=external --packages=external --outfile ./dist/sec.js ./src/sec.ts",
    "dev-hft-worker": "bun build --watch --target=bun --sourcemap=external --packages=external --outfile ./dist/hftWorker.js ./src/config/hftWorker.ts",
    "dev-types": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "bun run build-clean && bun run build-js",
    "build-clean": "rm -fr dist/*",
    "build-js": "bun run build-sec",
    "build-sec": "bun build --target=bun --packages=external --outfile ./dist/sec.js ./src/sec.ts && bun ./scripts/shebang-bin.ts ./dist/sec.js && bun run build-hft-worker",
    "build-hft-worker": "bun build --target=bun --packages=external --outfile ./dist/hftWorker.js ./src/config/hftWorker.ts",
    "typecheck": "bun check",
    "use-source": "bun ./scripts/bunsrc.ts source",
    "use-dist": "bun ./scripts/bunsrc.ts dist",
    "link": "bun link",
    "link-workglow": "bun ./scripts/link-workglow-packages.ts",
    "check-fixtures": "bun ./scripts/checkFixtures.ts",
    "test": "vitest run",
    "format": "oxfmt \"src/**/*.{js,ts,tsx,json}\"",
    "format-check": "oxfmt --check \"src/**/*.{js,ts,tsx,json}\"",
    "lint": "oxlint --type-aware --report-unused-disable-directives --deny-warnings src scripts",
    "lint-fix": "oxlint --fix src scripts"
  },
  "bin": {
    "sec": "./dist/sec.js"
  },
  "files": [
    "dist",
    "!**/*.map"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@workglow/cli": "0.6.13",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "html-entities": "^2.6.0",
    "pg": "^8.23.1",
    "typebox": "1.3.37",
    "workglow": "0.6.13"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/pg": "^8.23.1",
    "bunset": "1.1.2",
    "concurrently": "^10.0.6",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  },
  "trustedDependencies": [
    "@huggingface/transformers",
    "onnxruntime-node"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "hono": "^4.13.2",
    "sharp": "0.35.3",
    "adm-zip": "^0.6.0",
    "js-yaml": "^5.3.0",
    "nanoid": "^6.0.1",
    "qs": "^6.15.3",
    "tar": "^7.5.22",
    "fast-uri": "^4.1.2",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
